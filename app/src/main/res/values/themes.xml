<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TouristGuide" parent="Theme.Material3.Light.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/olive</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/cream</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>
    <style name="Widget.Tourista.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/terracotta</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

    </style>

    <style name="Widget.Tourista.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/terracotta</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">16dp</item>

    </style>
</resources>